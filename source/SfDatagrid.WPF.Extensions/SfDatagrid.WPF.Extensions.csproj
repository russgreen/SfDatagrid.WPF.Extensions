<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
		<UseWPF>true</UseWPF>
		<VersionPrefix>0.1.0</VersionPrefix>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup>
		<PackageType>Dependency</PackageType>
		<PackageId>SfDatagrid.WPF.Extensions</PackageId>
		<Authors>Russ Green</Authors>
		<Description>Extension methods of Syncfusion WPF SfDatagrid</Description>
		<!--<GeneratePackageOnBuild>True</GeneratePackageOnBuild>-->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/russgreen/SfDatagrid.WPF.Extensions</RepositoryUrl>
		<PackageProjectUrl>https://github.com/russgreen/SfDatagrid.WPF.Extensions</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<DebugType>portable</DebugType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	
	<ItemGroup>
	  <PackageReference Include="Syncfusion.SfGrid.WPF" Version="29.*" />
	</ItemGroup>	

	<!-- Link the solution-root README into the project and mark it to be packed at package root -->
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
	</ItemGroup>

</Project>
